  "flow": {
    "triggers": [
      {
        "id": "doorbell_rang",
        "title": {
          "en": "Doorbell rang",
          "it": "Campanello suonato"
        },
        "hint": {
          "en": "When someone rings the doorbell",
          "it": "Quando qualcuno suona il campanello"
        },
        "tokens": [
          {
            "name": "timestamp",
            "type": "string",
            "title": {
              "en": "Time",
              "it": "Ora"
            },
            "example": {
              "en": "12/13/2025, 6:23:39 PM",
              "it": "13/12/2025, 18:23:39"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "EasyKit"
      },
      "class": "lock",
      "capabilities": [
        "locked"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [],
      "images": {
        "small": "/drivers/lock/assets/images/small.png",
        "large": "/drivers/lock/assets/images/large.png",
        "xlarge": "/drivers/lock/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "check_settings",
          "template": "loading"
        },
        {
          "id": "bticino_login"
        },
        {
          "id": "choose_plant"
        },
        {
          "id": "register_device",
          "template": "loading"
        },
        {
          "id": "list_lock_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "id": "lock",
      "settings": [
        {
          "id": "autoClose",
          "type": "checkbox",
          "label": {
            "en": "Auto-Close Lock"
          },
          "value": false,
          "hint": {
            "en": "Close the lock automatically after a delay."
          }
        },
        {
          "id": "autoCloseDelay",
          "type": "number",
          "label": {
            "en": "Auto-Close Delay"
          },
          "hint": {
            "en": "The delay in seconds before the lock auto closes."
          },
          "value": 30,
          "min": 0,
          "max": 600,
          "units": {
            "en": "seconds"
          }
        }
      ]
    }
  ]
}