{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.dimapp.bticino.doorentry",
  "version": "2.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "BTicino Door Entry EasyKit"
  },
  "description": {
    "en": "Turn your BTicino Door Entry system into a smart home gateway",
    "it": "Trasforma il tuo sistema BTicino Door Entry in un gateway smart home"
  },
  "category": [
    "appliances"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Simone Di Maio",
    "email": "simone.dimaio77@gmail.com"
  },
  "brandColor": "#f36f21",
  "source": "https://github.com/s-dimaio/com.dimapp.bticino.doorentry.git",
  "bugs": {
    "url": "https://github.com/s-dimaio/com.dimapp.bticino.doorentry/issues"
  },
  "tags": {
    "en": [
      "BTicino",
      "Door Entry",
      "Intercom",
      "Video Doorbell"
    ],
    "it": [
      "BTicino",
      "Door Entry",
      "Citofono",
      "Videocitofono",
      "Campanello"
    ]
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "sdimaio77"
      }
    }
  },
  "api": {
    "getAccountStatus": {
      "method": "GET",
      "path": "/account/status"
    },
    "disconnectAccount": {
      "method": "POST",
      "path": "/account/disconnect"
    },
    "getDiagnosticPlants": {
      "method": "GET",
      "path": "/diagnostic/plants"
    },
    "getDiagnosticModules": {
      "method": "GET",
      "path": "/diagnostic/modules"
    },
    "getDiagnosticSipAccounts": {
      "method": "GET",
      "path": "/diagnostic/sip-accounts"
    },
    "listDiagnosticFiles": {
      "method": "GET",
      "path": "/diagnostic/files"
    },
    "deleteDiagnosticFile": {
      "method": "DELETE",
      "path": "/diagnostic/file/:filename"
    },
    "deleteAllDiagnosticFiles": {
      "method": "DELETE",
      "path": "/diagnostic/files"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "doorbell_call_missed",
        "title": {
          "en": "Doorbell call missed",
          "it": "Chiamata persa al campanello"
        },
        "hint": {
          "en": "When someone rings the doorbell and nobody answers",
          "it": "Quando qualcuno suona il campanello e nessuno risponde"
        },
        "tokens": [
          {
            "name": "timestamp",
            "type": "string",
            "title": {
              "en": "Time",
              "it": "Ora"
            },
            "example": {
              "en": "12/13/2025, 6:23:39 PM",
              "it": "13/12/2025, 18:23:39"
            }
          }
        ]
      },
      {
        "id": "doorbell_rang",
        "title": {
          "en": "Doorbell rang",
          "it": "Campanello suonato"
        },
        "hint": {
          "en": "When someone rings the doorbell",
          "it": "Quando qualcuno suona il campanello"
        },
        "tokens": [
          {
            "name": "timestamp",
            "type": "string",
            "title": {
              "en": "Time",
              "it": "Ora"
            },
            "example": {
              "en": "12/13/2025, 6:23:39 PM",
              "it": "13/12/2025, 18:23:39"
            }
          }
        ]
      },
      {
        "id": "service_connected",
        "title": {
          "en": "BTicino service connected",
          "it": "Servizio BTicino connesso"
        },
        "hint": {
          "en": "Triggered when the connection to BTicino cloud service is established or restored",
          "it": "Si attiva quando la connessione al servizio cloud BTicino viene stabilita o ripristinata"
        },
        "tokens": [
          {
            "name": "timestamp",
            "type": "string",
            "title": {
              "en": "Time",
              "it": "Ora"
            },
            "example": {
              "en": "12/13/2025, 6:23:39 PM",
              "it": "13/12/2025, 18:23:39"
            }
          }
        ]
      },
      {
        "id": "service_disconnected",
        "title": {
          "en": "BTicino service disconnected",
          "it": "Servizio BTicino disconnesso"
        },
        "hint": {
          "en": "Triggered when the connection to BTicino cloud service is lost",
          "it": "Si attiva quando la connessione al servizio cloud BTicino viene persa"
        },
        "tokens": [
          {
            "name": "timestamp",
            "type": "string",
            "title": {
              "en": "Time",
              "it": "Ora"
            },
            "example": {
              "en": "12/13/2025, 6:23:39 PM",
              "it": "13/12/2025, 18:23:39"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "service_is_connected",
        "title": {
          "en": "BTicino service !{{is|is not}} connected",
          "it": "Il servizio BTicino !{{è|non è}} connesso"
        },
        "hint": {
          "en": "Check if the app is currently connected to the BTicino cloud service",
          "it": "Verifica se l'app è attualmente connessa al servizio cloud BTicino"
        }
      }
    ],
    "actions": [
      {
        "id": "take_snapshot",
        "title": {
          "en": "Take a snapshot",
          "it": "Scatta un'istantanea"
        },
        "hint": {
          "en": "Capture a live snapshot from the camera",
          "it": "Cattura un'istantanea in tempo reale dalla telecamera"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=easykit&class=camera"
          }
        ],
        "tokens": [
          {
            "name": "snapshot",
            "type": "image",
            "title": {
              "en": "Snapshot",
              "it": "Istantanea"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "EasyKit"
      },
      "class": "lock",
      "capabilities": [
        "locked"
      ],
      "capabilitiesOptions": {
        "locked": {
          "uiQuickAction": true
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/easykit/assets/images/small.png",
        "large": "/drivers/easykit/assets/images/large.png",
        "xlarge": "/drivers/easykit/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "check_settings",
          "template": "loading"
        },
        {
          "id": "bticino_login"
        },
        {
          "id": "choose_plant"
        },
        {
          "id": "register_device",
          "template": "loading"
        },
        {
          "id": "list_lock_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "bticino_login"
        },
        {
          "id": "choose_plant"
        },
        {
          "id": "register_device",
          "template": "loading"
        }
      ],
      "id": "easykit",
      "settings": [
        {
          "id": "moduleId",
          "type": "text",
          "label": {
            "en": "Module ID",
            "it": "ID Modulo"
          },
          "value": "",
          "hint": {
            "en": "The unique BTicino module ID associated with this device. You can find this in Settings > Debug & Diagnostics.",
            "it": "L'ID univoco del modulo BTicino associato a questo dispositivo. Puoi trovarlo in Impostazioni > Debug e Diagnostica."
          }
        },
        {
          "id": "cameraIndex",
          "type": "label",
          "label": {
            "en": "Channel Index",
            "it": "Indice Canale"
          },
          "value": "0",
          "hint": {
            "en": "Channel index for this device (0 = Lock/Gate, 1 = Main outdoor camera, >1 = Secondary cameras).",
            "it": "Indice del canale per questo dispositivo (0 = Serratura/Cancello, 1 = Telecamera principale posto esterno, >1 = Telecamere secondarie)."
          }
        },
        {
          "id": "autoClose",
          "type": "checkbox",
          "label": {
            "en": "Auto-Close Lock",
            "it": "Chiusura automatica serratura"
          },
          "value": false,
          "hint": {
            "en": "Close the lock automatically after a delay.",
            "it": "Ripristina lo stato di chiuso automaticamente dopo un intervallo di tempo."
          }
        },
        {
          "id": "autoCloseDelay",
          "type": "number",
          "label": {
            "en": "Auto-Close Delay",
            "it": "Ritardo chiusura automatica"
          },
          "hint": {
            "en": "The delay in seconds before the lock auto closes.",
            "it": "Il ritardo in secondi prima del ripristino automatico."
          },
          "value": 30,
          "min": 0,
          "max": 600,
          "units": {
            "en": "seconds",
            "it": "secondi"
          }
        }
      ]
    }
  ]
}